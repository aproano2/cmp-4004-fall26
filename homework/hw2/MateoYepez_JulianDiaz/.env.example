# Copy to .env. No real LLM experiments run until explicitly configured.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# openai-compatible: full API base ending in /v1; ollama: http://localhost:11434
LLM_BASE_URL=
LLM_MODEL_SIZE=unknown
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_SEED=
SOLVER_TIMEOUT=10
REPEATS=3
# Blank means unknown, not zero. Values are configurable estimates/scenarios.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
LOCAL_PRICE_PER_HOUR=
PRICE_SOURCE=unconfigured; no monetary claim
PRICE_DATE=
